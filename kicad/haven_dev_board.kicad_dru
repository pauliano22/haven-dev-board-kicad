(rule "tight_hole_clearance_XTALO_vs_PDMDIN"
  (condition "(A.NetName == 'XTALO' && B.NetName == 'PDMDIN') || (B.NetName == 'XTALO' && A.NetName == 'PDMDIN')")
  (constraint hole_clearance (min 0.05mm)))

(rule "tight_hole_clearance_XTALO_vs_V_LS"
