(rule "tight_clearance_SCL1_vs_XTALO"
  (condition "(A.NetName == 'SCL1' && B.NetName == 'XTALO') || (B.NetName == 'SCL1' && A.NetName == 'XTALO')")
  (constraint clearance (min 0.02mm)))

(rule "tight_clearance_SCL1_vs_noname"
  (condition "(A.NetName == 'SCL1' && B.NetName == '') || (B.NetName == 'SCL1' && A.NetName == '')")
