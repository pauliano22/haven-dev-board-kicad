  (constraint hole_clearance (min 0.05mm)))

# LED_ENABLE (formerly the broken "#ERROR" net, renamed after tracing it
# to MDBT531 pin 3 / P1.08 -- see CODEX_NOTES.md) needed a short new
# connection from Q2's gate to the rest of the net, which runs close to
# R4/Q2's own $1N117 copper.
(rule "tight_clearance_LED_ENABLE_vs_1N117"
  (condition "(A.NetName == 'LED_ENABLE' && B.NetName == '$1N117') || (B.NetName == 'LED_ENABLE' && A.NetName == '$1N117')")
  (constraint clearance (min 0.05mm)))

# SCL1's route (I2C clock to the audio codec U15) escapes U15's package
# via a keepout carved into the In4.Cu (+1.8V) pour -- see
# u15_audio_escape_keepout. Needed several tight pair exceptions right
# at the escape via, where it crosses TDO/XTALO/XTALI/PDMCLK's own
# copper in the same crowded corner.
(rule "tight_clearance_SCL1_vs_PDMCLK"
  (condition "(A.NetName == 'SCL1' && B.NetName == 'PDMCLK') || (B.NetName == 'SCL1' && A.NetName == 'PDMCLK')")
  (constraint clearance (min 0.05mm)))

(rule "tight_clearance_SCL1_vs_TDO"
  (condition "(A.NetName == 'SCL1' && B.NetName == 'TDO') || (B.NetName == 'SCL1' && A.NetName == 'TDO')")
  (constraint clearance (min 0.02mm)))

(rule "tight_clearance_SCL1_vs_XTALI"
  (condition "(A.NetName == 'SCL1' && B.NetName == 'XTALI') || (B.NetName == 'SCL1' && A.NetName == 'XTALI')")
  (constraint clearance (min 0.02mm)))

# XTALI's escape route (routed after SCL1/SDA1/LRCLK already occupied this
# corner) needed several more tight exceptions against that existing
# copper and against TDI's generic 0.15mm catch-all rule.
(rule "tight_clearance_XTALI_vs_TDI"
  (condition "(A.NetName == 'XTALI' && B.NetName == 'TDI') || (B.NetName == 'XTALI' && A.NetName == 'TDI')")
  (constraint clearance (min 0.03mm)))

(rule "tight_clearance_XTALI_vs_SDA1"
  (condition "(A.NetName == 'XTALI' && B.NetName == 'SDA1') || (B.NetName == 'XTALI' && A.NetName == 'SDA1')")
  (constraint clearance (min 0.015mm)))

(rule "tight_clearance_XTALI_vs_GND"
  (condition "(A.NetName == 'XTALI' && B.NetName == 'GND') || (B.NetName == 'XTALI' && A.NetName == 'GND')")
