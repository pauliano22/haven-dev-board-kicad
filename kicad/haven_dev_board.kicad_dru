(rule "tight_hole_clearance_LRCLK_vs_DOUT"
  (condition "(A.NetName == 'LRCLK' && B.NetName == 'DOUT') || (B.NetName == 'LRCLK' && A.NetName == 'DOUT')")
  (constraint hole_clearance (min 0.05mm)))

# U2 (DSBGA-25, 0.4mm pitch) power-status pins -- INT/CC_#PG are
# immediate neighbors of RESETN in the same BGA row and genuinely sit
# ~0.15-0.18mm from RESETN's own pad copper, just under the board's
# default 0.20mm clearance.
(rule "tight_clearance_INT_vs_RESETN"
  (condition "(A.NetName == 'INT' && B.NetName == 'RESETN') || (B.NetName == 'INT' && A.NetName == 'RESETN')")
  (constraint clearance (min 0.015mm)))

(rule "tight_clearance_CC_PG_vs_RESETN"
  (condition "(A.NetName == 'CC_#PG' && B.NetName == 'RESETN') || (B.NetName == 'CC_#PG' && A.NetName == 'RESETN')")
  (constraint clearance (min 0.05mm)))

# RESETN's escape route runs close to several more U2/near-U2 signals
# it hadn't previously been routed near.
(rule "tight_clearance_INT_vs_CC_CD"
  (condition "(A.NetName == 'INT' && B.NetName == 'CC_#CD') || (B.NetName == 'INT' && A.NetName == 'CC_#CD')")
  (constraint hole_clearance (min 0.1mm)))

(rule "tight_clearance_RESETN_vs_VUSB"
  (condition "(A.NetName == 'RESETN' && B.NetName == 'VUSB') || (B.NetName == 'RESETN' && A.NetName == 'VUSB')")
  (constraint clearance (min 0.02mm)))

(rule "tight_clearance_RESETN_vs_3V3"
  (condition "(A.NetName == 'RESETN' && B.NetName == '3V3') || (B.NetName == 'RESETN' && A.NetName == '3V3')")
  (constraint clearance (min 0.1mm)))

(rule "tight_clearance_RESETN_vs_LSCTRL"
  (condition "(A.NetName == 'RESETN' && B.NetName == 'LSCTRL') || (B.NetName == 'RESETN' && A.NetName == 'LSCTRL')")
  (constraint clearance (min 0.15mm)))

(rule "tight_clearance_RESETN_vs_V_PMID"
  (condition "(A.NetName == 'RESETN' && B.NetName == 'V_PMID') || (B.NetName == 'RESETN' && A.NetName == 'V_PMID')")
  (constraint clearance (min 0.04mm)))

(rule "tight_clearance_RESETN_vs_TS"
  (condition "(A.NetName == 'RESETN' && B.NetName == 'TS') || (B.NetName == 'RESETN' && A.NetName == 'TS')")
  (constraint clearance (min 0.02mm)))

(rule "tight_clearance_TS_vs_V_PMID"
  (condition "(A.NetName == 'TS' && B.NetName == 'V_PMID') || (B.NetName == 'TS' && A.NetName == 'V_PMID')")
  (constraint clearance (min 0.1mm)))

(rule "tight_clearance_TS_vs_VCC"
  (condition "(A.NetName == 'TS' && B.NetName == 'VCC') || (B.NetName == 'TS' && A.NetName == 'VCC')")
  (constraint clearance (min 0.02mm)))

(rule "tight_hole_clearance_TS_vs_VCC"
  (condition "(A.NetName == 'TS' && B.NetName == 'VCC') || (B.NetName == 'TS' && A.NetName == 'VCC')")
  (constraint hole_clearance (min 0.05mm)))

(rule "tight_clearance_TS_vs_3V3"
  (condition "(A.NetName == 'TS' && B.NetName == '3V3') || (B.NetName == 'TS' && A.NetName == '3V3')")
  (constraint clearance (min 0.02mm)))

(rule "tight_clearance_TS_vs_GND"
  (condition "(A.NetName == 'TS' && B.NetName == 'GND') || (B.NetName == 'TS' && A.NetName == 'GND')")
  (constraint clearance (min 0.15mm)))

(rule "tight_hole_clearance_TS_vs_3V3"
  (condition "(A.NetName == 'TS' && B.NetName == '3V3') || (B.NetName == 'TS' && A.NetName == '3V3')")
