  (constraint hole_to_hole (min 0.1mm)))

(rule "tight_clearance_XTALO_vs_SDA1"
  (condition "(A.NetName == 'XTALO' && B.NetName == 'SDA1') || (B.NetName == 'XTALO' && A.NetName == 'SDA1')")
