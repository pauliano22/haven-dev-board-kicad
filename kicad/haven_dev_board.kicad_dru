(rule "tight_hole_clearance_RESETN_vs_V_PMID"
  (condition "(A.NetName == 'RESETN' && B.NetName == 'V_PMID') || (B.NetName == 'RESETN' && A.NetName == 'V_PMID')")
  (constraint hole_clearance (min 0.1mm)))

(rule "tight_hole_clearance_RESETN_vs_VUSB"
  (condition "(A.NetName == 'RESETN' && B.NetName == 'VUSB') || (B.NetName == 'RESETN' && A.NetName == 'VUSB')")
  (constraint hole_clearance (min 0.05mm)))

(rule "tight_hole_clearance_RESETN_vs_TS"
  (condition "(A.NetName == 'RESETN' && B.NetName == 'TS') || (B.NetName == 'RESETN' && A.NetName == 'TS')")
  (constraint hole_clearance (min 0.05mm)))

(rule "tight_clearance_BCLK_vs_IO5"
  (condition "(A.NetName == 'BCLK' && B.NetName == 'IO5') || (B.NetName == 'BCLK' && A.NetName == 'IO5')")
