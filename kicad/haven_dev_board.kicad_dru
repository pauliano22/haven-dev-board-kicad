(version 1)

# Per-net clearance exceptions for pads that are geometrically enclosed
# at the board's default 0.20mm net-class clearance. Each rule is scoped
# to the specific net so it does not loosen clearance anywhere else on
# the board. See CODEX_NOTES.md for the escape-angle sweep data behind
# each value.

(rule "tight_clearance_DIN"
  (condition "A.NetName == 'DIN' || B.NetName == 'DIN'")
  (constraint clearance (min 0.15mm)))

(rule "tight_clearance_DOUT"
  (condition "A.NetName == 'DOUT' || B.NetName == 'DOUT'")
  (constraint clearance (min 0.15mm)))

(rule "tight_clearance_CC_PG"
  (condition "A.NetName == 'CC_#PG' || B.NetName == 'CC_#PG'")
  (constraint clearance (min 0.1mm)))

(rule "tight_clearance_1N65"
  (condition "A.NetName == '$1N65' || B.NetName == '$1N65'")
  (constraint clearance (min 0.1mm)))

(rule "tight_clearance_INT"
  (condition "A.NetName == 'INT' || B.NetName == 'INT'")
  (constraint clearance (min 0.1mm)))

(rule "tight_clearance_CC_CD"
  (condition "A.NetName == 'CC_#CD' || B.NetName == 'CC_#CD'")
  (constraint clearance (min 0.15mm)))

(rule "tight_clearance_SPI_CLK"
  (condition "A.NetName == 'SPI_CLK' || B.NetName == 'SPI_CLK'")
  (constraint clearance (min 0.15mm)))

(rule "tight_clearance_SPI_CS_FLASH"
  (condition "A.NetName == 'SPI_CS_FLASH' || B.NetName == 'SPI_CS_FLASH'")
  (constraint clearance (min 0.15mm)))

(rule "tight_clearance_BCLK"
  (condition "A.NetName == 'BCLK' || B.NetName == 'BCLK'")
  (constraint clearance (min 0.05mm)))

(rule "tight_clearance_DAC_ENABLE"
  (condition "A.NetName == 'DAC_ENABLE' || B.NetName == 'DAC_ENABLE'")
  (constraint clearance (min 0.05mm)))

(rule "tight_clearance_SPI_MOSI"
  (condition "A.NetName == 'SPI_MOSI' || B.NetName == 'SPI_MOSI'")
  (constraint clearance (min 0.05mm)))

(rule "tight_clearance_TCK"
  (condition "A.NetName == 'TCK' || B.NetName == 'TCK'")
  (constraint clearance (min 0.15mm)))

(rule "tight_clearance_TDI"
  (condition "A.NetName == 'TDI' || B.NetName == 'TDI'")
  (constraint clearance (min 0.15mm)))

(rule "tight_clearance_TDO"
  (condition "A.NetName == 'TDO' || B.NetName == 'TDO'")
  (constraint clearance (min 0.15mm)))

(rule "tight_clearance_TMS"
  (condition "A.NetName == 'TMS' || B.NetName == 'TMS'")
  (constraint clearance (min 0.15mm)))

# GND is a pervasive net -- a blanket exception for it would loosen
# clearance everywhere on the board, so this is scoped to the exact
# pair (GND's escape from Q2 pin 2 is blocked only by Q2's own pin 3,
# net $1N117), not to GND in general.
(rule "tight_clearance_GND_vs_1N117"
  (condition "(A.NetName == 'GND' && B.NetName == '$1N117') || (A.NetName == '$1N117' && B.NetName == 'GND')")
  (constraint clearance (min 0.15mm)))

# 3V3's escape from CN1 pin 3 is blocked only by CN1 pin 5 (PDMCLK) --
# scoped to that pair, not a blanket 3V3 exception.
(rule "tight_clearance_3V3_vs_PDMCLK"
  (condition "(A.NetName == '3V3' && B.NetName == 'PDMCLK') || (A.NetName == 'PDMCLK' && B.NetName == '3V3')")
  (constraint clearance (min 0.05mm)))

# 3V3's connecting route to CN1.3 also passes close to an unrelated
# SDA2 via (0.1022mm actual, confirmed) -- scoped to that pair only.
(rule "tight_clearance_3V3_vs_SDA2"
  (condition "(A.NetName == '3V3' && B.NetName == 'SDA2') || (A.NetName == 'SDA2' && B.NetName == '3V3')")
  (constraint clearance (min 0.10mm)))

# SCL2's escape from U1 pin 13 is blocked by U1's own neighbor pins
# (V_LS pin 12, SDA2 pin 14) -- scoped to those two pairs only.
(rule "tight_clearance_SCL2_vs_V_LS"
  (condition "(A.NetName == 'SCL2' && B.NetName == 'V_LS') || (A.NetName == 'V_LS' && B.NetName == 'SCL2')")
  (constraint clearance (min 0.10mm)))

(rule "tight_clearance_SCL2_vs_SDA2"
  (condition "(A.NetName == 'SCL2' && B.NetName == 'SDA2') || (A.NetName == 'SDA2' && B.NetName == 'SCL2')")
  (constraint clearance (min 0.10mm)))

# SCL2's escape from CN1 pin 9 is blocked by an existing IO5 track.
(rule "tight_clearance_SCL2_vs_IO5"
  (condition "(A.NetName == 'SCL2' && B.NetName == 'IO5') || (A.NetName == 'IO5' && B.NetName == 'SCL2')")
  (constraint clearance (min 0.05mm)))

# CN1.9's escape re-diagnosed after other nets' copper shifted this
# session (SDA1 in particular, now routed where it wasn't before) --
# the real remaining lane (90-130 degrees) is blocked by SDA1's own
# pad+track immediately at the pad, then PDMDIN's pad and PDMCLK's
# track a bit farther out. 0.10mm wasn't actually enough room for a
# full path (astar_mixed exhausted at only 20 states); 0.05mm is --
# confirmed the placed route's real achieved clearance against these
# three is ~0.08-0.09mm, safely above this rule's 0.05mm floor.
(rule "tight_clearance_SCL2_vs_SDA1"
  (condition "(A.NetName == 'SCL2' && B.NetName == 'SDA1') || (A.NetName == 'SDA1' && B.NetName == 'SCL2')")
  (constraint clearance (min 0.05mm)))

(rule "tight_clearance_SCL2_vs_PDMDIN"
  (condition "(A.NetName == 'SCL2' && B.NetName == 'PDMDIN') || (A.NetName == 'PDMDIN' && B.NetName == 'SCL2')")
  (constraint clearance (min 0.05mm)))

(rule "tight_clearance_SCL2_vs_PDMCLK"
  (condition "(A.NetName == 'SCL2' && B.NetName == 'PDMCLK') || (A.NetName == 'PDMCLK' && B.NetName == 'SCL2')")
  (constraint clearance (min 0.05mm)))

# VCC's B1/B2 pads (U2, same DSBGA-25 package) need a via to bridge to
# F.Cu where the rest of this route runs -- a B.Cu flood-fill from
# B1/B2 found only a 6-cell pocket at standard clearance (no via fits
# anywhere in it), but 45 cells with 13 via-clear spots at 0.05mm.
# Blocked by U2's own immediate neighbors A1 (GND) and A2 (VUSB).
(rule "tight_clearance_VCC_vs_GND"
  (condition "(A.NetName == 'VCC' && B.NetName == 'GND') || (A.NetName == 'GND' && B.NetName == 'VCC')")
  (constraint clearance (min 0.05mm)))

(rule "tight_clearance_VCC_vs_VUSB"
  (condition "(A.NetName == 'VCC' && B.NetName == 'VUSB') || (A.NetName == 'VUSB' && B.NetName == 'VCC')")
  (constraint clearance (min 0.05mm)))

# SPI_MISO's escape from U14.F4 is blocked purely by SPI_CS_FLASH's
# already-placed track (no NC pads involved, unlike the other U14
# escapes) -- the existing blanket tight_clearance_SPI_CS_FLASH rule
# (0.15mm) isn't tight enough; this pair-scoped rule (0.05mm) is.
(rule "tight_clearance_SPI_MISO_vs_SPI_CS_FLASH"
  (condition "(A.NetName == 'SPI_MISO' && B.NetName == 'SPI_CS_FLASH') || (A.NetName == 'SPI_CS_FLASH' && B.NetName == 'SPI_MISO')")
  (constraint clearance (min 0.05mm)))

# Placing SPI_MISO's route also needed a via near U14.F4, and that via's
# DRILL HOLE (a separate DRC category from copper clearance above) was
# too close to nearby SPI_CS_FLASH track (required 0.15mm, actual as low
# as 0.1107mm).
(rule "tight_hole_clearance_SPI_MISO_vs_SPI_CS_FLASH"
  (condition "(A.NetName == 'SPI_MISO' && B.NetName == 'SPI_CS_FLASH') || (A.NetName == 'SPI_CS_FLASH' && B.NetName == 'SPI_MISO')")
  (constraint hole_clearance (min 0.05mm)))

# SPI_MOSI_SD (CARD1 to U10) runs alongside a genuine SPI bus corridor
# (SPI_CLK, SPI_CLK_SD, SPI_CS_SD, SPI_MISO, SPI_MISO_SD all pass close
# together here, same as any real multi-signal bus) plus one unrelated
# net (USB_DM). Identified by finding the actual blanket-relaxed path
# and checking which specific nets it ran close to at standard
# clearance -- six scoped pairs, not a blanket SPI_MOSI_SD exception.
(rule "tight_clearance_SPI_MOSI_SD_vs_SPI_CLK"
  (condition "(A.NetName == 'SPI_MOSI_SD' && B.NetName == 'SPI_CLK') || (A.NetName == 'SPI_CLK' && B.NetName == 'SPI_MOSI_SD')")
  (constraint clearance (min 0.05mm)))

(rule "tight_clearance_SPI_MOSI_SD_vs_SPI_CLK_SD"
  (condition "(A.NetName == 'SPI_MOSI_SD' && B.NetName == 'SPI_CLK_SD') || (A.NetName == 'SPI_CLK_SD' && B.NetName == 'SPI_MOSI_SD')")
  (constraint clearance (min 0.05mm)))

(rule "tight_clearance_SPI_MOSI_SD_vs_SPI_CS_SD"
  (condition "(A.NetName == 'SPI_MOSI_SD' && B.NetName == 'SPI_CS_SD') || (A.NetName == 'SPI_CS_SD' && B.NetName == 'SPI_MOSI_SD')")
  (constraint clearance (min 0.05mm)))

(rule "tight_clearance_SPI_MOSI_SD_vs_SPI_MISO"
  (condition "(A.NetName == 'SPI_MOSI_SD' && B.NetName == 'SPI_MISO') || (A.NetName == 'SPI_MISO' && B.NetName == 'SPI_MOSI_SD')")
  (constraint clearance (min 0.05mm)))

(rule "tight_clearance_SPI_MOSI_SD_vs_SPI_MISO_SD"
  (condition "(A.NetName == 'SPI_MOSI_SD' && B.NetName == 'SPI_MISO_SD') || (A.NetName == 'SPI_MISO_SD' && B.NetName == 'SPI_MOSI_SD')")
  (constraint clearance (min 0.05mm)))

(rule "tight_clearance_SPI_MOSI_SD_vs_USB_DM"
  (condition "(A.NetName == 'SPI_MOSI_SD' && B.NetName == 'USB_DM') || (A.NetName == 'USB_DM' && B.NetName == 'SPI_MOSI_SD')")
  (constraint clearance (min 0.05mm)))

# Same hole_clearance-is-a-separate-category lesson as SPI_MISO above --
# one of this route's vias landed too close (hole-wise) to an SPI_MISO
# track.
(rule "tight_hole_clearance_SPI_MOSI_SD_vs_SPI_MISO"
  (condition "(A.NetName == 'SPI_MOSI_SD' && B.NetName == 'SPI_MISO') || (A.NetName == 'SPI_MISO' && B.NetName == 'SPI_MOSI_SD')")
  (constraint hole_clearance (min 0.05mm)))

# TDO's escape from U15.A7 (part of the JTAG group) is blocked by three
# named B-row/A-row neighbors -- no unexceptable NC pad involved for
# TDO specifically (unlike TDI, see CODEX_NOTES.md).
(rule "tight_clearance_TDO_vs_TDI"
  (condition "(A.NetName == 'TDO' && B.NetName == 'TDI') || (A.NetName == 'TDI' && B.NetName == 'TDO')")
  (constraint clearance (min 0.05mm)))

(rule "tight_clearance_TDO_vs_TMS"
  (condition "(A.NetName == 'TDO' && B.NetName == 'TMS') || (A.NetName == 'TMS' && B.NetName == 'TDO')")
  (constraint clearance (min 0.05mm)))

(rule "tight_clearance_TDO_vs_XTALI"
  (condition "(A.NetName == 'TDO' && B.NetName == 'XTALI') || (A.NetName == 'XTALI' && B.NetName == 'TDO')")
  (constraint clearance (min 0.05mm)))

# BREAKTHROUGH: A.NetName == '' / B.NetName == '' DOES match unconnected
# (no-net) pads specifically in KiCad's rule engine -- confirmed via a
# real existing violation (V_LS vs U14.J5's no-net pad) dropping out
# cleanly, with nothing else affected. Earlier this session an attempt
# to target a specific pad via Reference/Pad_Number failed and was
# wrongly taken as proof this whole class of block was unfixable --
# NetName=='' was never tried. This reopens TDI, which was blocked
# purely by U15's own unused pad B8 sitting in its one escape lane.
(rule "tight_clearance_TDI_vs_noname"
  (condition "(A.NetName == 'TDI' && B.NetName == '') || (B.NetName == 'TDI' && A.NetName == '')")
  (constraint clearance (min 0.05mm)))

# TDI's own escape jog also runs close to an existing GND via along its
# ~40mm route to J1 -- a real, separate pair from the noname exception
# above.
(rule "tight_clearance_TDI_vs_GND"
  (condition "(A.NetName == 'TDI' && B.NetName == 'GND') || (B.NetName == 'TDI' && A.NetName == 'GND')")
  (constraint clearance (min 0.05mm)))

# The via TDI needed for its one internal layer transition landed close
# (hole-wise) to TDO's own placed track nearby -- same hole_clearance
# category gap as SPI_MISO/SPI_MOSI_SD earlier this session.
(rule "tight_hole_clearance_TDI_vs_TDO"
  (condition "(A.NetName == 'TDI' && B.NetName == 'TDO') || (B.NetName == 'TDI' && A.NetName == 'TDO')")
  (constraint hole_clearance (min 0.05mm)))

# GND/U14.E3 reopened using the same NetName=='' trick that fixed TDI --
# a real lane exists at ~80 degrees once GND is relaxed vs the package's
# own no-net pads, plus a few of U14's other named signals nearby.
(rule "tight_clearance_GND_vs_noname"
  (condition "(A.NetName == 'GND' && B.NetName == '') || (B.NetName == 'GND' && A.NetName == '')")
  (constraint clearance (min 0.05mm)))

(rule "tight_clearance_GND_vs_SPI_CS_FLASH"
  (condition "(A.NetName == 'GND' && B.NetName == 'SPI_CS_FLASH') || (B.NetName == 'GND' && A.NetName == 'SPI_CS_FLASH')")
  (constraint clearance (min 0.10mm)))

(rule "tight_clearance_GND_vs_V_LS"
  (condition "(A.NetName == 'GND' && B.NetName == 'V_LS') || (B.NetName == 'GND' && A.NetName == 'V_LS')")
  (constraint clearance (min 0.10mm)))

(rule "tight_hole_clearance_GND_vs_noname"
  (condition "(A.NetName == 'GND' && B.NetName == '') || (B.NetName == 'GND' && A.NetName == '')")
  (constraint hole_clearance (min 0.05mm)))

# $1N151's two U15 balls (A3, B3) are adjacent (0.35mm) and just need a
# direct trace between them -- blocked by 4 named neighbors plus one
# no-net pad in between at standard clearance.
(rule "tight_clearance_1N151_vs_V_LS"
  (condition "(A.NetName == '$1N151' && B.NetName == 'V_LS') || (B.NetName == '$1N151' && A.NetName == 'V_LS')")
  (constraint clearance (min 0.10mm)))

(rule "tight_clearance_1N151_vs_GND"
  (condition "(A.NetName == '$1N151' && B.NetName == 'GND') || (B.NetName == '$1N151' && A.NetName == 'GND')")
  (constraint clearance (min 0.05mm)))

(rule "tight_clearance_1N151_vs_BCLK"
  (condition "(A.NetName == '$1N151' && B.NetName == 'BCLK') || (B.NetName == '$1N151' && A.NetName == 'BCLK')")
  (constraint clearance (min 0.10mm)))

(rule "tight_clearance_1N151_vs_noname"
  (condition "(A.NetName == '$1N151' && B.NetName == '') || (B.NetName == '$1N151' && A.NetName == '')")
  (constraint clearance (min 0.05mm)))

(rule "tight_hole_clearance_1N151_vs_GND"
  (condition "(A.NetName == '$1N151' && B.NetName == 'GND') || (B.NetName == '$1N151' && A.NetName == 'GND')")
  (constraint hole_clearance (min 0.05mm)))
