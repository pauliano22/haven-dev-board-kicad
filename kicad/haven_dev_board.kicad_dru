  (constraint hole_clearance (min 0.05mm)))

(rule "tight_hole_clearance_XTALI_vs_PDMCLK"
  (condition "(A.NetName == 'XTALI' && B.NetName == 'PDMCLK') || (B.NetName == 'XTALI' && A.NetName == 'PDMCLK')")
