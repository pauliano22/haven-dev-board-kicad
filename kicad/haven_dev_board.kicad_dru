(rule "tight_hole_clearance_RESETN_vs_INT"
  (condition "(A.NetName == 'RESETN' && B.NetName == 'INT') || (B.NetName == 'RESETN' && A.NetName == 'INT')")
  (constraint hole_clearance (min 0.05mm)))

(rule "tight_hole_clearance_RESETN_vs_CC_PG"
  (condition "(A.NetName == 'RESETN' && B.NetName == 'CC_#PG') || (B.NetName == 'RESETN' && A.NetName == 'CC_#PG')")
