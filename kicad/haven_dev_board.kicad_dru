(rule "tight_clearance_XTALI_vs_noname"
  (condition "(A.NetName == 'XTALI' && B.NetName == '') || (B.NetName == 'XTALI' && A.NetName == '')")
  (constraint clearance (min 0.08mm)))

(rule "tight_hole_clearance_XTALI_vs_TDI"
  (condition "(A.NetName == 'XTALI' && B.NetName == 'TDI') || (B.NetName == 'XTALI' && A.NetName == 'TDI')")
  (constraint hole_clearance (min 0.05mm)))

